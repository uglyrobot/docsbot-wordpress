{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"landingPage": "/wp-admin/admin.php?page=plugin-check",
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "plugin-check"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "docsbot/docsbot.php"
		}
	]
}
