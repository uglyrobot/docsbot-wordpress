#: docsbot/includes/class-docsbot-admin.php:455
msgid "Allow the configured TidyCal scheduling action."
msgstr "Die konfigurierte TidyCal-Terminaktion erlauben."

#: docsbot/includes/class-docsbot-admin.php:456
msgid "Custom action buttons"
msgstr "Benutzerdefinierte Aktionsschaltflächen"

#: docsbot/includes/class-docsbot-admin.php:456
msgid "Allow custom button tools configured in DocsBot."
msgstr ""
"In DocsBot konfigurierte benutzerdefinierte Schaltflächen-Werkzeuge "
"erlauben."

#: docsbot/includes/class-docsbot-admin.php:457
msgid "Agent activity"
msgstr "Agentenaktivität"

#: docsbot/includes/class-docsbot-admin.php:457
msgid "Show concise thinking and tool progress while the agent works."
msgstr ""
"Kurze Hinweise zum Denkprozess und Werkzeugfortschritt anzeigen, während der"
" Agent arbeitet."

#: docsbot/includes/class-docsbot-admin.php:459
msgid "Save actions"
msgstr "Aktionen speichern"

#: docsbot/includes/class-docsbot-admin.php:479
#: docsbot/includes/class-docsbot-admin.php:1252
