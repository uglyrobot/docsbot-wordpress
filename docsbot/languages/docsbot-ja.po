msgid "Audience"
msgstr "対象ユーザー"

#: docsbot/includes/class-docsbot-admin.php:517
msgid "Only show to logged-in WordPress users"
msgstr "ログイン中の WordPress ユーザーにのみ表示"

#: docsbot/includes/class-docsbot-admin.php:519
msgid "Allowed WordPress roles"
msgstr "許可する WordPress 権限グループ"

#: docsbot/includes/class-docsbot-admin.php:520
